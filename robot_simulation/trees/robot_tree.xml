<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4" main_tree_to_execute="Robot">

  <BehaviorTree ID="Robot">
    <ReactiveSequence name="Guards">
      <IsSafe/>
      <IsAutomaticMode/>
      <ReactiveFallback name="PauseOrWork">
        <ReactiveSequence name="Pause">
          <IsPaused/>
          <HoldPosition/>
        </ReactiveSequence>
        <Fallback name="Work">
          <ReactiveSequence name="HasOrder">
            <HasActiveOrder/>
            <SubTree ID="ExecuteOrder"/>
          </ReactiveSequence>
          <WaitForOrder/>
        </Fallback>
      </ReactiveFallback>
    </ReactiveSequence>
  </BehaviorTree>

  <BehaviorTree ID="ExecuteOrder">
    <Sequence name="OrderStep">
      <Fallback name="Drive">
        <Sequence>
          <HasBaseAhead/>
          <DriveSegment/>
        </Sequence>
        <AlwaysSuccess name="NothingToDrive"/>
      </Fallback>
      <ExecuteNodeActions/>
      <Fallback name="WaitForUpdate">
        <Sequence>
          <AtDecisionPoint/>
          <WaitForBaseExtension/>
        </Sequence>
        <AlwaysSuccess name="NoHorizon"/>
      </Fallback>
    </Sequence>
  </BehaviorTree>

  <!-- Описание своих нод для Groot2 (редактор). -->
  <TreeNodesModel>
    <Condition ID="IsSafe">
      <description>Нет аварийной остановки и нарушения защитного поля (state.safetyState)</description>
    </Condition>
    <Condition ID="IsAutomaticMode">
      <description>operatingMode = AUTOMATIC или SEMIAUTOMATIC</description>
    </Condition>
    <Condition ID="IsPaused">
      <description>Робот на паузе после instant action startPause</description>
    </Condition>
    <Condition ID="HasActiveOrder">
      <description>Робот не idle: есть nodeStates/edgeStates или незавершённые action'ы</description>
    </Condition>
    <Condition ID="HasBaseAhead">
      <description>Впереди робота есть released-узлы</description>
    </Condition>
    <Condition ID="AtDecisionPoint">
      <description>Released-узлов впереди нет, но в nodeStates остался horizon</description>
    </Condition>
    <Action ID="HoldPosition">
      <description>Стоять на месте, пока не снимут паузу (прерывается родителем)</description>
    </Action>
    <Action ID="WaitForOrder">
      <description>RUNNING, пока у робота не появится активный order</description>
    </Action>
    <Action ID="DriveSegment">
      <description>Доехать до ближайшей точки остановки; onHalted — плавная остановка</description>
    </Action>
    <Action ID="ExecuteNodeActions">
      <description>Выполнить action'ы узла с учётом blockingType; без action'ов — SUCCESS сразу</description>
    </Action>
    <Action ID="WaitForBaseExtension">
      <description>Ждать update, продлевающий base; на время ожидания newBaseRequest = true</description>
    </Action>
  </TreeNodesModel>

</root>
